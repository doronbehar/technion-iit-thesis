@article{MoleculeLaserCooled,
  title = {Magneto-Optical Trapping and Sub-{{Doppler}} Cooling of a Polyatomic Molecule},
  author = {Vilas, Nathaniel B. and Hallas, Christian and Anderegg, Loïc and Robichaud, Paige and Winnicki, Andrew and Mitra, Debayan and Doyle, John M.},
  date = {2022-06},
