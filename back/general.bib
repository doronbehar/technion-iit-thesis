@article{PasteurChirality,
author = {Vantomme, Ghislaine and Crassous, Jeanne},
title = {Pasteur and chirality: A story of how serendipity favors the prepared minds},
journal = {Chirality},
volume = {33},
number = {10},
pages = {597-601},
doi = {https://doi.org/10.1002/chir.23349},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/chir.23349},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/chir.23349},
abstract = {Abstract During the XIXth century, France has been the theater of many discoveries in stereochemistry thanks to prestigious physicists, chemists, and crystallographers. Among them, Louis Pasteur is certainly the father of molecular chirality (the so-called molecular dissymmetry), and because of the exceptionally favored conditions of his famous discovery on the resolution of tartrates, his findings have often been attributed to serendipity. But let us not forget that “in the fields of observation, chance only favors the prepared minds.”},
year = {2021}
}
